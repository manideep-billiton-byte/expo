# Testing Environment Configuration
# This uses the PRODUCTION database but runs locally for testing
# WARNING: Changes made during testing WILL affect production data

PORT=5001
NODE_ENV=testing

# Use production database (same data as production)
DATABASE_URL=postgresql://postgres:EventPass123!@expo-project-prod-db.cvmk8awyksm7.ap-south-1.rds.amazonaws.com:5432/expo_db

# Base URL for invite links (will be updated when ngrok starts)
INVITE_LINK_BASE=http://localhost:5001

# Email Configuration (using same as production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Expo Testing <noreply@test.com>"

# Twilio SMS (optional for testing - leave empty to skip SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# GST API
GST_API_KEY=
